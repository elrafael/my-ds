{
  "name": "my-ds",
  "version": "0.0.4",
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/my-ds/my-ds.esm.js",
  "exports": {
    ".": {
      "import": "./dist/my-ds/my-ds.esm.js",
      "require": "./dist/my-ds/my-ds.cjs.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./my-component": {
      "types": "./dist/components/my-component.d.ts",
      "import": "./dist/components/my-component.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elrafael/my-ds"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "pack:local": "npm run build && npm version patch --no-git-tag-version && npm pack",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --prod --watch",
    "generate": "stencil generate",
    "build:watch": "stencil build --dev --watch",
    "storybook": "storybook dev -p 6006",
    "storybook:dev": "concurrently \"stencil build --dev --watch\" \"storybook dev -p 6006\"",
    "build-storybook": "npm run build && storybook build"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@stencil/angular-output-target": "^1.6.0",
    "@stencil/core": "^4.27.1 || ^5.0.0-0",
    "@stencil/sass": "^3.3.3",
    "@stencil/vitest": "^1.8.3",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/web-components-vite": "^10.6.7",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "concurrently": "^10.0.7",
    "lit": "latest",
    "playwright": "^1.52.0",
    "storybook": "^10.6.7",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
